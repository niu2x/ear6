# Native, WebAssembly, and packaged Web build outputs.
/build/
/build-web/

# Local environment files may contain machine-specific paths or secrets.
.env
.env.local
.env.*.local

# OS and editor metadata.
.DS_Store
*.swp
*.swo

# ROM images are local by default and must not be committed accidentally.
*.NES
*.nes

# Small redistributable fixtures are intentional repository inputs.
!/tests/fixtures/
!/tests/fixtures/**

# Keep the local ROM instructions, but ignore mapper folders and ROM content.
/tests/local-roms/nes/*
!/tests/local-roms/nes/README.md
